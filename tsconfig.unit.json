// Unit tests only: resolves @tenant to jnvpjaa. The app build gets @tenant from next.config.js (TENANT),
// so it must not be in tsconfig.json — Next's tsconfig-paths resolver would override the alias.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@tenant/*": [
        "./tenants/jnvpjaa/*"
      ],
      "@/containers/*": [
        "./src/containers/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/pages/*": [
        "./src/pages/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/styles/*": [
        "./src/styles/*"
      ],
      "@/mocks/*": [
        "./__mocks__/*"
      ],
      "@/utils/*": [
        "./src/utils/*"
      ],
      "@/context/*": [
        "./src/context/*"
      ],
      "@/constants/*": [
        "./src/constants/*"
      ],
      "@/layouts/*": [
        "./src/layouts/*"
      ],
      "@/apollo/*": [
        "./src/apollo/*"
      ],
      "@/config/*": [
        "./src/config/*"
      ],
      "@/modules/*": [
        "./src/modules/*"
      ],
      "@/types/*": [
        "./src/types/*"
      ]
    }
  }
}
